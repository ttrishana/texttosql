# Base URL of the text-to-SQL FastAPI backend (uvicorn texttosql.api.main:app).
# The Next.js API routes proxy to this server-side, so it is never exposed to the browser.
TEXTTOSQL_BACKEND_URL=http://localhost:8000

# Only needed if the backend was started with API_KEY set. Injected server-side
# as the X-API-Key header on /query — keep it out of client code.
TEXTTOSQL_API_KEY=
