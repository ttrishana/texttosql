# ---- LLM (Google Gemini) ----
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
# Free-tier request quotas are tiny and vary by key (often only gemini-2.5-flash
# has any, ~20/day; 2.0-flash and 2.5-pro may be 0). See https://ai.dev/rate-limit.
# Enable billing for real use; on a paid key set MAIN to gemini-2.5-pro for best SQL.
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash

# ---- Database ----
# Admin role: used ONLY by scripts/init_db.py for DDL + seeding.
ADMIN_DATABASE_URL=postgresql+psycopg://texttosql_admin:admin_pw@localhost:5432/firmdb
# Read-only role: the ONLY role the agent uses at query time.
READONLY_DATABASE_URL=postgresql+psycopg://texttosql_readonly:readonly_pw@localhost:5432/firmdb

# ---- Local testing WITHOUT Docker (embedded Postgres) ----
# Set true + `pip install -e ".[embedded]"` to run a pip-installed Postgres (with
# pgvector) rooted at EMBEDDED_PGDATA. The *_DATABASE_URL values above are ignored.
EMBEDDED_DB=false
EMBEDDED_PGDATA=.pgdata

# ---- Multi-database routing ----
# When true, the agent routes each question to one of the domain databases in
# knowledge/sources.yaml (hr/audit/tax/billing). When false, one firm database.
MULTI_DB=false

# ---- Agent behavior ----
MAX_CORRECTION_ATTEMPTS=3
RESULT_ROW_CAP=1000
STATEMENT_TIMEOUT_MS=15000
# Set true to retrieve relevant tables/few-shots via pgvector instead of full-schema-in-context.
RETRIEVAL_MODE=false

# ---- API (optional) ----
# If set, /query requires header  X-API-Key: <this value>
API_KEY=

# ---- Observability (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=texttosql
